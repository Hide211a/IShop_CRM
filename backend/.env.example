# === Локальна розробка (SQLite) ===
DATABASE_URL="file:./dev.db"

# Секрет для JWT — у production обов'язково довгий випадковий рядок
JWT_SECRET="change-me-in-production-use-long-random-string"

PORT=3001

# CORS: дозволені origin фронтенду (через кому, якщо кілька)
# Локально:
CORS_ORIGIN="http://localhost:5173"

# === Production (Railway + Vercel) ===
# DATABASE_URL — PostgreSQL (Railway підставляє автоматично при підключенні plugin)
# DATABASE_URL="postgresql://user:pass@host:5432/railway"
# JWT_SECRET="your-64-char-random-secret"
# CORS_ORIGIN="https://your-app.vercel.app"
# NODE_ENV=production — на Railway встановлюється автоматично
# JWT_SECRET обов'язковий у production (мін. 16 символів, не значення з прикладу)
